# The data sources each page starts with, where {region} stands for a region, {year} for a year, and {streams} for the
# streams archive chosen: streams_thinner, streams, or streams_denser, and the first and last years of runoff a period
# may reach. A build reads these; the dev server reads those of .env.development instead.
VITE_ROUTING_PARAMETERS=https://d2bu4ozwm6rcbq.cloudfront.net/routing/region={region}/routing.parquet
VITE_GRID_WEIGHTS=https://d2bu4ozwm6rcbq.cloudfront.net/routing/region={region}/gridweights_ERA5_{region}.parquet
VITE_RUNOFF=https://v3.s3.riverforecastsystem.com/forcings/era5/{year}.zarr/ro
VITE_RUNOFF_GRID=https://v3.s3.riverforecastsystem.com/forcings/era5/1940.zarr/ro
VITE_RUNOFF_FIRST_YEAR=1940
VITE_RUNOFF_LAST_YEAR=2024
VITE_STREAMS=https://d2bu4ozwm6rcbq.cloudfront.net/hydrography/global/{streams}.pmtiles
