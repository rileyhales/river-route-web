# Loaded only by the dev server: the data/ it serves, a link to ~/river-forecast-system-v3, laid out as the cdn lays it
# out, with the ERA5 runoff of 1940 to 1944.
VITE_ROUTING_PARAMETERS=data/routing/region={region}/network.parquet
VITE_GRID_WEIGHTS=data/routing/region={region}/gridweights_ERA5_{region}.parquet
VITE_RUNOFF=data/forcings/era5/{year}.zarr/ro
VITE_RUNOFF_GRID=data/forcings/era5/1940.zarr/ro
VITE_RUNOFF_FIRST_YEAR=1940
VITE_RUNOFF_LAST_YEAR=1944
VITE_STREAMS=data/hydrography/global/{streams}.pmtiles
