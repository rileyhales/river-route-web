# Loaded only by the dev server: the data/ it serves, a link to a copy of the rfsv3 data laid out as the cdn lays it out.
# It holds no ERA5 runoff, so runoff is read from s3 as a build reads it.
VITE_ROUTING_PARAMETERS=data/routing/region={region}/routing.parquet
VITE_GRID_WEIGHTS=data/routing/region={region}/gridweights_ERA5_{region}.parquet
VITE_RUNOFF=https://v3.s3.riverforecastsystem.com/forcings/era5/{year}.zarr/ro
VITE_RUNOFF_GRID=https://v3.s3.riverforecastsystem.com/forcings/era5/1940.zarr/ro
VITE_RUNOFF_FIRST_YEAR=1940
VITE_RUNOFF_LAST_YEAR=2024
VITE_STREAMS=data/hydrography/global/{streams}.pmtiles
